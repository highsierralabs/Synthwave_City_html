{
  "name": "synthwave-city-64k",
  "version": "0.1.0",
  "private": true,
  "description": "Synthwave City as one self-contained HTML file, as small as it will go. No dependencies, no asset files.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "size": "node scripts/size.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "probe": "node scripts/probe.mjs",
    "input": "node scripts/input.mjs",
    "steady": "node scripts/steady.mjs",
    "dev": "node scripts/dev.mjs",
    "shot": "node scripts/shot.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "check:task": "node scripts/check-task.mjs",
    "plans:check": "node scripts/plans-check.mjs"
  },
  "devDependencies": {
    "@gfx/zopfli": "1.0.15",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
